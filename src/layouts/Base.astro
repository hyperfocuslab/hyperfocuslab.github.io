---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { EMAIL, GAME_URL, HARUBOX_LANGS, HARUBOX_LANG_CODE, HARUBOX_LANG_LABEL, HARUBOX_UI, LANGS, LANG_CODE, LANG_LABEL, PRODUCT_NAME, SHELTIE_LANGS, SITE, cockatooHref, cockatooName, haruboxHomeLang, haruboxHref, haruboxName, href, sheltieHref, ui, type HaruboxLang, type Lang, type Page, type Product } from '../i18n';

interface Props {
  // Harubox and Cockatoo pages use eight languages, four more than the rest of the site.
  lang: Lang | HaruboxLang;
  page: Page;
  title: string;
  description: string;
  // Sheltie and Cockatoo pages have their own links; the default is Peakly and the home.
  product?: Product;
}

const { lang, page, title, description, product = 'peakly' } = Astro.props;
const isHarubox = product === 'harubox';
// Cockatoo shares Harubox's eight languages, labels and header/footer strings.
const isCockatoo = product === 'cockatoo';
const isWide = isHarubox || isCockatoo;
// The company home and the other products exist in four languages; Harubox and Cockatoo pages in
// other languages show the company home of their nearest language (English).
const siteLang: Lang = isWide ? haruboxHomeLang(lang as HaruboxLang) : (lang as Lang);
const t = isWide
  ? { ...ui[siteLang], nav: HARUBOX_UI[lang as HaruboxLang].nav, docs: { ...ui[siteLang].docs, ...HARUBOX_UI[lang as HaruboxLang].docs }, footer: { ...ui[siteLang].footer, legal: HARUBOX_UI[lang as HaruboxLang].legal } }
  : ui[lang as Lang];
// Every product other than Peakly has its own languages, name and links.
const isOther = product !== 'peakly';
const productName = isHarubox ? haruboxName(lang as HaruboxLang) : isCockatoo ? cockatooName(lang as HaruboxLang) : product === 'peakly' ? t.appName : PRODUCT_NAME[product];
// Sheltie documents exist in ko and en only; other languages link to the English ones.
const sheltieLang = (SHELTIE_LANGS as readonly string[]).includes(lang) ? (lang as 'ko' | 'en') : 'en';
const haruboxLangs: readonly HaruboxLang[] = HARUBOX_LANGS;
const langs: readonly (Lang | HaruboxLang)[] = isWide ? haruboxLangs : isOther ? SHELTIE_LANGS : LANGS;
const langLabel = (l: Lang | HaruboxLang) => (isWide ? HARUBOX_LANG_LABEL[l as HaruboxLang] : LANG_LABEL[l as Lang]);
const langCode = (l: Lang | HaruboxLang) => (isWide ? HARUBOX_LANG_CODE[l as HaruboxLang] : LANG_CODE[l as Lang]);
const pageHref = (p: Page, l: Lang | HaruboxLang) =>
  isHarubox
    ? haruboxHref(p === 'harubox' ? 'product' : (p as 'support' | 'privacy'), l as HaruboxLang)
    : product === 'cockatoo'
      ? cockatooHref(p === 'cockatoo' ? 'product' : (p as 'support' | 'privacy'), l as HaruboxLang)
      : product === 'sheltie'
        ? sheltieHref(p === 'sheltie' ? 'product' : (p as 'support' | 'privacy'), l as Lang)
        : href(p, l as Lang);
const productHome = isHarubox ? haruboxHref('product', lang as HaruboxLang) : isCockatoo ? cockatooHref('product', lang as HaruboxLang) : sheltieHref('product', lang as Lang);
// The company home is its own section; every other page belongs to a product (Peakly or Sheltie).
const inPeakly = page !== 'home';
// First-visit language redirect runs only on the root home, which is English.
const autoLang = lang === 'en' && page === 'home';
const canonical = SITE + pageHref(page, lang);
// Same family as the Peakly app (IBM Plex Sans KR), with the JP cut for Japanese.
// IBM Plex has no Traditional Chinese cut, so zh-Hant uses Noto Sans TC.
const plex = lang === 'ja' ? 'IBM+Plex+Sans+JP' : lang === 'zh-Hant' ? 'Noto+Sans+TC' : 'IBM+Plex+Sans+KR';
const fontCss = `https://fonts.googleapis.com/css2?family=${plex}:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap`;
// Share cards exist for ko/en/ja only; Traditional Chinese pages use the English card.
const ogLang = lang === 'zh-Hant' ? 'en' : lang;
const GA_ID = 'G-96T0GRTD1R';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {
      autoLang && (
        <script is:inline set:html={`// Send first-time visitors to their browser language before anything paints.
// Arriving from a page of this site (e.g. the EN link) wins, then a stored choice (hfl_lang).
(() => {
  try {
    if (/bot|crawl|spider|slurp|lighthouse|headless|inspectiontool|yeti/i.test(navigator.userAgent)) return;
    if (document.referrer && new URL(document.referrer).origin === location.origin) return;
    let stored = null;
    try { stored = localStorage.getItem('hfl_lang'); } catch (e) {}
    const l = (stored || (navigator.languages && navigator.languages[0]) || navigator.language || 'en').toLowerCase();
    const home = l.startsWith('ko') ? '/ko/' : l.startsWith('ja') ? '/ja/' : /^zh-(tw|hk|mo|hant)/.test(l) ? '/zh-Hant/' : '';
    if (home) location.replace(home + location.search + location.hash);
  } catch (e) {}
})();`} />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={SITE + pageHref(page, l)} />)}
    <link rel="alternate" hreflang="x-default" href={SITE + pageHref(page, 'en')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={isOther ? productName : page === 'home' ? 'Hyperfocus Lab' : t.appName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- Shared links preview the page's own card: the company card on the home, the app's effect-curve
         screen on Peakly pages. Bump ?v= when a card changes: KakaoTalk caches images by URL. -->
    {
      isOther ? (
        <meta name="twitter:card" content="summary" />
      ) : (
        <>
          <meta property="og:image" content={page === 'home' ? `${SITE}/assets/og-home.png?v=1` : `${SITE}/assets/og-${ogLang}.png?v=5`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <meta name="theme-color" content="#070708" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontCss} />
    {
      // Site visits and where they come from (GA4 property "hyperfocuslab.app", separate from the Peakly app property).
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', GA_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href={href('home', siteLang)} aria-label="Hyperfocus Lab">
          <Logo size={22} />
          <span class="wordmark-text">Hyperfocus Lab</span>
        </a>
        {
          inPeakly && (
            <a
              class="crumb"
              href={isOther ? productHome : href('peakly', siteLang)}
              aria-current={page === 'peakly' || page === 'sheltie' || page === 'cockatoo' || page === 'harubox' ? 'page' : undefined}
            >
              {isOther ? productName : 'Peakly'}
            </a>
          )
        }
        <nav class="site-nav" aria-label={t.nav.main}>
          {page !== 'support' && <a href={pageHref('support', lang)}>{t.nav.contact}</a>}
          <div class="langs" role="group" aria-label={t.nav.language}>
            {
              langs.map((l) => (
                <a
                  href={pageHref(page, l)}
                  lang={l}
                  hreflang={l}
                  title={langLabel(l)}
                  aria-label={langLabel(l)}
                  aria-current={l === lang ? 'page' : undefined}
                >
                  {langCode(l)}
                </a>
              ))
            }
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <a class="wordmark footer-mark" href={href('home', siteLang)} aria-label="Hyperfocus Lab">
          <Logo size={22} />
          <span class="wordmark-text">Hyperfocus Lab</span>
        </a>
        {
          !isOther && (
            <nav aria-label={t.footer.products}>
              <p class="footer-head">{t.footer.products}</p>
              <a href={href('peakly', siteLang)}>{t.appName}</a>
              <a href={href('sheltie', siteLang)}>Sheltie</a>
              <a href={cockatooHref('product', siteLang)}>{cockatooName(siteLang)}</a>
              <a href={haruboxHref('product', siteLang)}>{haruboxName(siteLang)}</a>
              <a href={GAME_URL} target="_blank" rel="noreferrer">DEAD DISTRICT</a>
            </nav>
          )
        }
        <nav aria-label={isOther ? productName : t.appName}>
          <p class="footer-head">{isOther ? productName : t.appName}</p>
          <a href={pageHref('support', lang)}>{t.docs.support}</a>
          <a href={pageHref('privacy', lang)}>{t.docs.privacy}</a>
          {!isOther && <a href={href('terms', siteLang)}>{t.docs.terms}</a>}
        </nav>
        {
          !isOther && (
            <nav aria-label="Sheltie">
              <p class="footer-head">Sheltie</p>
              <a href={sheltieHref('support', sheltieLang)}>{t.docs.support}</a>
              <a href={sheltieHref('privacy', sheltieLang)}>{t.docs.privacy}</a>
            </nav>
          )
        }
        {
          // Cockatoo pages exist in every site language: each page links to its own language.
          !isOther && (
            <nav aria-label={cockatooName(lang as Lang)}>
              <p class="footer-head">{cockatooName(lang as Lang)}</p>
              <a href={cockatooHref('support', lang as Lang)}>{t.docs.support}</a>
              <a href={cockatooHref('privacy', lang as Lang)}>{t.docs.privacy}</a>
            </nav>
          )
        }
        <nav aria-label={t.footer.language}>
          <p class="footer-head">{t.footer.language}</p>
          {
            langs.map((l) => (
              <a href={pageHref(page, l)} lang={l} hreflang={l} aria-current={l === lang ? 'page' : undefined}>
                {langLabel(l)}
              </a>
            ))
          }
        </nav>
      </div>
      <div class="wrap footer-bottom">
        <p>{t.footer.legal} · <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      </div>
    </footer>
    <script is:inline>
      // A visitor from an @Peakly_dev post (utm_campaign=p-YYYYMMDD-xxxx, set by x-ops) carries that
      // post id into the store links, so App Store Connect (ct) and Play Console (referrer) count
      // installs per post. Read from this page's URL only; nothing is stored between pages.
      (() => {
        try {
          const camp = new URLSearchParams(location.search).get('utm_campaign');
          if (!camp || !/^p-[0-9]{8}-[a-z0-9]{4}$/.test(camp)) return;
          document.querySelectorAll('a[href^="https://apps.apple.com/"]').forEach((a) => {
            const u = new URL(a.href);
            u.searchParams.set('ct', camp);
            a.href = u.href;
          });
          document.querySelectorAll('a[href^="https://play.google.com/"]').forEach((a) => {
            const u = new URL(a.href);
            const ref = new URLSearchParams(u.searchParams.get('referrer') || '');
            ref.set('utm_campaign', camp);
            u.searchParams.set('referrer', ref.toString());
            a.href = u.href;
          });
        } catch (_) {}
      })();
    </script>
    <script is:inline>
      // Remember an explicit language choice so the first-visit redirect never overrides it.
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element) || !e.target.closest('a[hreflang]')) return;
        try { localStorage.setItem('hfl_lang', e.target.closest('a[hreflang]').getAttribute('hreflang')); } catch (_) {}
      });
    </script>
    <script is:inline>
      // Light scroll reveal: content rises a little as it enters the viewport.
      // Without JS, or with reduced motion, everything is simply visible.
      (() => {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('reveal-on');
        const targets = document.querySelectorAll(
          '.p-intro, .feature-copy, .feature-visual, .feature-cards li, .section-head, .facts, .email, .doc-head'
        );
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        targets.forEach((el) => {
          const siblings = el.parentElement ? [...el.parentElement.children] : [];
          if (el.matches('.feature-cards li')) el.style.transitionDelay = `${siblings.indexOf(el) * 60}ms`;
          if (el.matches('.feature-visual')) el.style.transitionDelay = '120ms';
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
