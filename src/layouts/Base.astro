---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { EMAIL, LANGS, LANG_CODE, LANG_LABEL, SHELTIE_LANGS, SITE, href, sheltieHref, storeLinks, ui, type Lang, type Page, type Product } from '../i18n';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  // Sheltie pages (support, privacy) have their own links; the default is Peakly and the home.
  product?: Product;
}

const { lang, page, title, description, product = 'peakly' } = Astro.props;
const t = ui[lang];
const isSheltie = product === 'sheltie';
const langs: readonly Lang[] = isSheltie ? SHELTIE_LANGS : LANGS;
const pageHref = (p: Page, l: Lang) => (isSheltie ? sheltieHref(p as 'support' | 'privacy', l) : href(p, l));
// The company home is its own section; every other page belongs to Peakly.
const inPeakly = page !== 'home';
// First-visit language redirect runs only on the root home, which is English.
const autoLang = lang === 'en' && page === 'home';
const canonical = SITE + pageHref(page, lang);
// Same family as the Peakly app (IBM Plex Sans KR), with the JP cut for Japanese.
// IBM Plex has no Traditional Chinese cut, so zh-Hant uses Noto Sans TC.
const plex = lang === 'ja' ? 'IBM+Plex+Sans+JP' : lang === 'zh-Hant' ? 'Noto+Sans+TC' : 'IBM+Plex+Sans+KR';
const fontCss = `https://fonts.googleapis.com/css2?family=${plex}:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap`;
// Share cards exist for ko/en/ja only; Traditional Chinese pages use the English card.
const ogLang = lang === 'zh-Hant' ? 'en' : lang;
const GA_ID = 'G-96T0GRTD1R';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {
      autoLang && (
        <script is:inline set:html={`// Send first-time visitors to their browser language before anything paints.
// Arriving from a page of this site (e.g. the EN link) wins, then a stored choice (hfl_lang).
(() => {
  try {
    if (/bot|crawl|spider|slurp|lighthouse|headless|inspectiontool|yeti/i.test(navigator.userAgent)) return;
    if (document.referrer && new URL(document.referrer).origin === location.origin) return;
    let stored = null;
    try { stored = localStorage.getItem('hfl_lang'); } catch (e) {}
    const l = (stored || (navigator.languages && navigator.languages[0]) || navigator.language || 'en').toLowerCase();
    const home = l.startsWith('ko') ? '/ko/' : l.startsWith('ja') ? '/ja/' : /^zh-(tw|hk|mo|hant)/.test(l) ? '/zh-Hant/' : '';
    if (home) location.replace(home + location.search + location.hash);
  } catch (e) {}
})();`} />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={SITE + pageHref(page, l)} />)}
    <link rel="alternate" hreflang="x-default" href={SITE + pageHref(page, 'en')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={isSheltie ? 'Sheltie' : t.appName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- While Peakly is the only product, shared links preview the app (effect-curve screen).
         Bump ?v= when the card changes: KakaoTalk caches images by URL. -->
    {
      isSheltie ? (
        <meta name="twitter:card" content="summary" />
      ) : (
        <>
          <meta property="og:image" content={`${SITE}/assets/og-${ogLang}.png?v=5`} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <meta name="theme-color" content="#070708" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontCss} />
    {
      // Site visits and where they come from (GA4 property "hyperfocuslab.app", separate from the Peakly app property).
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline define:vars={{ GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', GA_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href={href('home', lang)} aria-label="Hyperfocus Lab">
          <Logo size={22} />
          <span class="wordmark-text">Hyperfocus Lab</span>
        </a>
        {
          inPeakly && (
            <a
              class="crumb"
              href={isSheltie ? sheltieHref('support', lang) : href('peakly', lang)}
              aria-current={page === 'peakly' ? 'page' : undefined}
            >
              {isSheltie ? 'Sheltie' : 'Peakly'}
            </a>
          )
        }
        <nav class="site-nav" aria-label={t.nav.main}>
          {page !== 'support' && <a href={pageHref('support', lang)}>{t.nav.contact}</a>}
          <div class="langs" role="group" aria-label={t.nav.language}>
            {
              langs.map((l) => (
                <a
                  href={pageHref(page, l)}
                  lang={l}
                  hreflang={l}
                  title={LANG_LABEL[l]}
                  aria-label={LANG_LABEL[l]}
                  aria-current={l === lang ? 'page' : undefined}
                >
                  {LANG_CODE[l]}
                </a>
              ))
            }
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <a class="wordmark footer-mark" href={href('home', lang)} aria-label="Hyperfocus Lab">
          <Logo size={22} />
          <span class="wordmark-text">Hyperfocus Lab</span>
        </a>
        {
          !isSheltie && (
            <nav aria-label={t.footer.products}>
              <p class="footer-head">{t.footer.products}</p>
              <a href={`${href('home', lang)}#products`}>{t.appName}</a>
              <a href={storeLinks(lang).appStore} target="_blank" rel="noreferrer">App Store ↗</a>
              <a href={storeLinks(lang).googlePlay} target="_blank" rel="noreferrer">Google Play ↗</a>
            </nav>
          )
        }
        <nav aria-label={isSheltie ? 'Sheltie' : t.appName}>
          <p class="footer-head">{isSheltie ? 'Sheltie' : t.appName}</p>
          <a href={pageHref('support', lang)}>{t.docs.support}</a>
          <a href={pageHref('privacy', lang)}>{t.docs.privacy}</a>
          {!isSheltie && <a href={href('terms', lang)}>{t.docs.terms}</a>}
        </nav>
        <nav aria-label={t.footer.language}>
          <p class="footer-head">{t.footer.language}</p>
          {
            langs.map((l) => (
              <a href={pageHref(page, l)} lang={l} hreflang={l} aria-current={l === lang ? 'page' : undefined}>
                {LANG_LABEL[l]}
              </a>
            ))
          }
        </nav>
      </div>
      <div class="wrap footer-bottom">
        <p>{t.footer.legal} · <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      </div>
    </footer>
    <script is:inline>
      // A visitor from an @Peakly_dev post (utm_campaign=p-YYYYMMDD-xxxx, set by x-ops) carries that
      // post id into the store links, so App Store Connect (ct) and Play Console (referrer) count
      // installs per post. Read from this page's URL only; nothing is stored between pages.
      (() => {
        try {
          const camp = new URLSearchParams(location.search).get('utm_campaign');
          if (!camp || !/^p-[0-9]{8}-[a-z0-9]{4}$/.test(camp)) return;
          document.querySelectorAll('a[href^="https://apps.apple.com/"]').forEach((a) => {
            const u = new URL(a.href);
            u.searchParams.set('ct', camp);
            a.href = u.href;
          });
          document.querySelectorAll('a[href^="https://play.google.com/"]').forEach((a) => {
            const u = new URL(a.href);
            const ref = new URLSearchParams(u.searchParams.get('referrer') || '');
            ref.set('utm_campaign', camp);
            u.searchParams.set('referrer', ref.toString());
            a.href = u.href;
          });
        } catch (_) {}
      })();
    </script>
    <script is:inline>
      // Remember an explicit language choice so the first-visit redirect never overrides it.
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element) || !e.target.closest('a[hreflang]')) return;
        try { localStorage.setItem('hfl_lang', e.target.closest('a[hreflang]').getAttribute('hreflang')); } catch (_) {}
      });
    </script>
    <script is:inline>
      // Light scroll reveal: content rises a little as it enters the viewport.
      // Without JS, or with reduced motion, everything is simply visible.
      (() => {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('reveal-on');
        const targets = document.querySelectorAll(
          '.p-intro, .feature-copy, .feature-visual, .feature-cards li, .section-head, .facts, .email, .doc-head'
        );
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        targets.forEach((el) => {
          const siblings = el.parentElement ? [...el.parentElement.children] : [];
          if (el.matches('.feature-cards li')) el.style.transitionDelay = `${siblings.indexOf(el) * 60}ms`;
          if (el.matches('.feature-visual')) el.style.transitionDelay = '120ms';
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
