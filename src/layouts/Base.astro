---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { EMAIL, LANGS, LANG_LABEL, SITE, STORE, href, ui, type Lang, type Page } from '../i18n';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const t = ui[lang];
// The company home is its own section; every other page belongs to Peakly.
const inPeakly = page !== 'home';
const canonical = SITE + href(page, lang);
// Same family as the Peakly app (IBM Plex Sans KR), with the JP cut for Japanese.
const plex = lang === 'ja' ? 'IBM+Plex+Sans+JP' : 'IBM+Plex+Sans+KR';
const fontCss = `https://fonts.googleapis.com/css2?family=${plex}:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={SITE + href(page, l)} />)}
    <link rel="alternate" hreflang="x-default" href={SITE + href(page, 'en')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hyperfocus Lab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/assets/peakly-logo.png`} />
    <meta name="theme-color" content="#070708" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontCss} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href={href('home', lang)} aria-label="Hyperfocus Lab">
          <Logo size={22} />
          <span class="wordmark-text">Hyperfocus Lab</span>
        </a>
        {
          inPeakly && (
            <a class="crumb" href={href('peakly', lang)} aria-current={page === 'peakly' ? 'page' : undefined}>
              {t.appName}
            </a>
          )
        }
        <nav class="site-nav" aria-label={t.nav.main}>
          {
            inPeakly ? (
              <a href={href('support', lang)} aria-current={page === 'support' ? 'page' : undefined}>
                {t.nav.support}
              </a>
            ) : (
              <a href={href('support', lang)}>{t.nav.contact}</a>
            )
          }
          <div class="langs" role="group" aria-label={t.nav.language}>
            {
              LANGS.map((l) => (
                <a
                  href={href(page, l)}
                  lang={l}
                  hreflang={l}
                  title={LANG_LABEL[l]}
                  aria-label={LANG_LABEL[l]}
                  aria-current={l === lang ? 'page' : undefined}
                >
                  {l.toUpperCase()}
                </a>
              ))
            }
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <a class="wordmark footer-mark" href={href('home', lang)} aria-label="Hyperfocus Lab">
          <Logo size={22} />
          <span class="wordmark-text">Hyperfocus Lab</span>
        </a>
        <nav aria-label={t.footer.products}>
          <p class="footer-head">{t.footer.products}</p>
          <a href={`${href('home', lang)}#products`}>{t.appName}</a>
          <a href={STORE.appStore} target="_blank" rel="noreferrer">App Store ↗</a>
          <a href={STORE.googlePlay} target="_blank" rel="noreferrer">Google Play ↗</a>
        </nav>
        <nav aria-label={t.appName}>
          <p class="footer-head">{t.appName}</p>
          <a href={href('support', lang)}>{t.docs.support}</a>
          <a href={href('privacy', lang)}>{t.docs.privacy}</a>
          <a href={href('terms', lang)}>{t.docs.terms}</a>
        </nav>
        <nav aria-label={t.footer.language}>
          <p class="footer-head">{t.footer.language}</p>
          {
            LANGS.map((l) => (
              <a href={href(page, l)} lang={l} hreflang={l} aria-current={l === lang ? 'page' : undefined}>
                {LANG_LABEL[l]}
              </a>
            ))
          }
        </nav>
      </div>
      <div class="wrap footer-bottom">
        <p>{t.footer.legal} · <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      </div>
    </footer>
    <script is:inline>
      // Light scroll reveal: content rises a little as it enters the viewport.
      // Without JS, or with reduced motion, everything is simply visible.
      (() => {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('reveal-on');
        const targets = document.querySelectorAll(
          '.p-intro, .feature-copy, .feature-visual, .feature-cards li, .section-head, .facts, .email, .doc-head'
        );
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        targets.forEach((el) => {
          const siblings = el.parentElement ? [...el.parentElement.children] : [];
          if (el.matches('.feature-cards li')) el.style.transitionDelay = `${siblings.indexOf(el) * 60}ms`;
          if (el.matches('.feature-visual')) el.style.transitionDelay = '120ms';
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
