---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import AppShot from './AppShot.astro';
import { sheltieLinks, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sheltie = ui[lang].home.sheltie;
// Sheltie has ko and en captures only (public/assets/sheltie/{ko,en}-{shot}.webp); ja and zh-Hant show en.
// Captures exist per language (ko, en, ja, zh-Hant); a language without them shows en.
const shotLang = existsSync(`public/assets/sheltie/${lang}-list.webp`) ? lang : 'en';
const sheltieRows = sheltie.rows.filter((row) => existsSync(`public/assets/sheltie/${shotLang}-${row.shot}.webp`));
const sheltieLinkSet = sheltieLinks(lang);
---

<Base lang={lang} page="sheltie" product="sheltie" title={sheltie.title} description={sheltie.lead}>
  <section class="section" id="sheltie">
    <div class="wrap">
      <div class="p-intro">
        <div class="product-name">
          <img class="app-icon" src="/assets/sheltie-icon.webp" alt="" width="72" height="72" loading="lazy" />
          <div>
            <h1 class="h2">Sheltie</h1>
            <p class="muted">{sheltie.tagline}</p>
          </div>
        </div>
        <p class="lead">{sheltie.lead}</p>
        <div class="actions store">
          <a class="btn" href={sheltieLinkSet.appStore} target="_blank" rel="noreferrer">App Store ↗</a>
          <a class="btn btn-ghost" href={sheltieLinkSet.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a class="btn btn-ghost" href="#android">{sheltie.android.button}</a>
        </div>
      </div>

      <div class="rows-feature">
        {
          sheltieRows.map((row, index) => (
            <div class:list={['feature-row', { flip: index % 2 === 1 }]}>
              <div class="feature-copy">
                <p class="label">{row.label}</p>
                <h3 class="h2">{row.title}</h3>
                <p class="lead">{row.body}</p>
              </div>
              <div class="feature-visual">
                <AppShot src={`/assets/sheltie/${shotLang}-${row.shot}.webp`} alt={row.alt} lang={lang} />
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="label p-sub">{sheltie.agentsLabel}</h3>
      <p class="lead">{sheltie.agents}</p>
      <p class="row-note p-req">{sheltie.requirements}</p>

      <h3 class="label p-sub" id="android">{sheltie.android.label}</h3>
      <ol class="lead steps">
        <li>1. <a href={sheltieLinkSet.testerGroup} target="_blank" rel="noreferrer">{sheltie.android.steps[0]} ↗</a></li>
        <li>2. <a href={sheltieLinkSet.testerOptIn} target="_blank" rel="noreferrer">{sheltie.android.steps[1]} ↗</a></li>
        <li>3. <a href={sheltieLinkSet.play} target="_blank" rel="noreferrer">{sheltie.android.steps[2]} ↗</a></li>
      </ol>
      <p class="row-note p-req">{sheltie.android.note}</p>
    </div>
  </section>

</Base>
