---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import AppShot from './AppShot.astro';
import StoreBadges from './StoreBadges.astro';
import { href, sheltieLinks, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].home;
// The home is the company page: the name, then the products as a list (no tagline: the products say it).
// Each product shows one capture and links to its own page.
// Traditional Chinese has no Peakly captures of its own yet, so it shows the English ones;
// Sheltie has ko and en captures only, so ja and zh-Hant show en.
const peaklyShotLang = lang === 'zh-Hant' ? 'en' : lang;
const peaklyDark = `public/assets/peakly/${peaklyShotLang}-chart-dark.webp`;
const sheltieLang = lang === 'ko' ? 'ko' : 'en';
const sheltieLinkSet = sheltieLinks(lang);
---

<Base lang={lang} page="home" title={t.title} description={t.description}>
  <section class="section" id="company">
    <div class="wrap">
      <div class="p-intro">
        <h1 class="h2">Hyperfocus Lab</h1>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="feature-row">
        <div class="feature-copy">
          <div class="product-name">
            <img class="app-icon" src="/assets/peakly-icon.webp" alt="" width="72" height="72" />
            <div>
              <h2 class="h2">{ui[lang].appName}</h2>
              <p class="muted">{t.peakly.tagline}</p>
            </div>
          </div>
          <p class="lead">{t.peakly.lead}</p>
          <StoreBadges lang={lang} />
          <a class="arrow-link" href={href('peakly', lang)}>{t.more}</a>
        </div>
        <div class="feature-visual">
          <AppShot
            src={`/assets/peakly/${peaklyShotLang}-chart.webp`}
            darkSrc={existsSync(peaklyDark) ? `/assets/peakly/${peaklyShotLang}-chart-dark.webp` : undefined}
            alt={t.peakly.sections[0].rows[0].alt}
            lang={lang}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="feature-row flip">
        <div class="feature-copy">
          <div class="product-name">
            <img class="app-icon" src="/assets/sheltie-icon.webp" alt="" width="72" height="72" loading="lazy" />
            <div>
              <h2 class="h2">Sheltie</h2>
              <p class="muted">{t.sheltie.tagline}</p>
            </div>
          </div>
          <p class="lead">{t.sheltie.lead}</p>
          <div class="actions store">
            <a class="btn" href={sheltieLinkSet.appStore} target="_blank" rel="noreferrer">App Store ↗</a>
            <a class="btn btn-ghost" href={sheltieLinkSet.github} target="_blank" rel="noreferrer">GitHub ↗</a>
            <a class="btn btn-ghost" href={`${href('sheltie', lang)}#android`}>{t.sheltie.android.button}</a>
          </div>
          <a class="arrow-link" href={href('sheltie', lang)}>{t.more}</a>
        </div>
        <div class="feature-visual">
          <AppShot src={`/assets/sheltie/${sheltieLang}-question.webp`} alt={t.sheltie.rows[2].alt} lang={lang} />
        </div>
      </div>
    </div>
  </section>
</Base>
