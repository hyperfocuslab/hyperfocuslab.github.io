---
// The effect timing tool: one page per language, plus one per drug so each share link gets
// its own card. The default state (dose at 08:00) is rendered at build; the browser re-renders
// on every change. The drug is kept in the path (/ko/peakly/timing/concerta/); the dose time
// goes only into the link the copy button makes (?t=08:00), never into the address bar, so the
// site's analytics (Base.astro) sees the path and not the dose time. The curve itself is
// computed in the page and the inputs are not sent to any server.
import Base from '../layouts/Base.astro';
import { href, storeLinks } from '../i18n';
import type { DrugId } from '../lib/pk';
import { DEFAULT_DRUG, DEFAULT_MINUTES, copy, describe, render, selectGroups, toHHMM, type TimingLang } from '../lib/timing';

interface Props {
  lang: TimingLang;
  /** The drug page; the index page leaves it out and starts with the default drug. */
  drug?: DrugId;
}
const { lang, drug } = Astro.props;
const t = copy[lang];
const current = drug ?? DEFAULT_DRUG;
const first = render({ lang, drug: current, minutes: DEFAULT_MINUTES, nowHours: null });
const title = t.title(t.names[current]);
const description = describe(lang, current);
const ogImage = `/assets/og/timing-${lang}-${current}.png`;
// Installs from this tool are counted apart from the rest of the site (campaign timing-tool-{lang}).
const { appStore, googlePlay } = storeLinks(lang, `timing-tool-${lang}`);
const groups = selectGroups(lang, current);
---

<Base lang={lang} page="timing" sub={drug} title={title} description={description} ogImage={ogImage}>
  <section class="section timing" id="timing" data-lang={lang} data-drug={current} data-base={href('timing', lang)}>
    <div class="wrap">
      <header class="timing-head">
        <p class="label">{t.label}</p>
        <h1 class="h2">{t.h1}</h1>
        <p class="lead">{t.lead}</p>
      </header>

      <form class="pk-controls" id="pk-form">
        <label>
          <span class="label">{t.drug}</span>
          <select name="drug" id="pk-drug">
            {groups[0].ids.map((id) => <option value={id} selected={id === current}>{t.names[id]}</option>)}
            {groups[1].ids.length > 0 && (
              <optgroup label={groups[1].label}>
                {groups[1].ids.map((id) => <option value={id} selected={id === current}>{t.names[id]}</option>)}
              </optgroup>
            )}
          </select>
        </label>
        <label>
          <span class="label">{t.time}</span>
          <input type="time" name="t" id="pk-time" value={toHHMM(DEFAULT_MINUTES)} step="300" required />
        </label>
        <button type="button" class="btn btn-ghost" id="pk-copy" data-copied={t.copied}>{t.copy}</button>
      </form>

      <div class="pk-panel">
        <div class="pk-status" id="pk-status" set:html={first.status} />
        <div class="pk-legend" id="pk-legend" set:html={first.legend} />
        <div class="pk-chart" id="pk-chart" set:html={first.chart} />
        <div class="pk-axis" id="pk-axis" set:html={first.axis} />
      </div>
      <p class="pk-summary lead" id="pk-summary" set:html={first.summary} />

      <section class="pk-sources" aria-labelledby="pk-sources-title">
        <h2 class="label" id="pk-sources-title">{t.sourcesTitle}</h2>
        <div id="pk-sources" set:html={first.sources} />
      </section>

      <div class="pk-notice">{t.notice.map((p) => <p>{p}</p>)}</div>

      <div class="p-closing">
        <img class="app-icon" src="/assets/peakly-icon.webp" alt="" width="72" height="72" loading="lazy" />
        <h2 class="h2">{t.cta.title}</h2>
        <p class="lead">{t.cta.body}</p>
        <!-- Both stores carry the same weight: Android is a large share of Korean visitors. -->
        <div class="actions pk-stores">
          <a class="btn" href={appStore} target="_blank" rel="noreferrer">App Store ↗</a>
          <a class="btn" href={googlePlay} target="_blank" rel="noreferrer">Google Play ↗</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { isDrugId, type DrugId } from '../lib/pk';
  import { DEFAULT_MINUTES, copy, hoursSinceDose, parseMinutes, render, toHHMM, type TimingLang } from '../lib/timing';

  const root = document.getElementById('timing')!;
  const lang = root.dataset.lang as TimingLang;
  const base = root.dataset.base!;
  const t = copy[lang];
  const drugSelect = document.getElementById('pk-drug') as HTMLSelectElement;
  const timeInput = document.getElementById('pk-time') as HTMLInputElement;
  const copyButton = document.getElementById('pk-copy') as HTMLButtonElement;
  const out = {
    status: document.getElementById('pk-status')!,
    legend: document.getElementById('pk-legend')!,
    chart: document.getElementById('pk-chart')!,
    axis: document.getElementById('pk-axis')!,
    summary: document.getElementById('pk-summary')!,
    sources: document.getElementById('pk-sources')!,
  };

  // State comes from the page's drug, then the query (?drug=concerta&t=08:00) on top.
  const params = new URLSearchParams(location.search);
  const queried = params.get('drug');
  let drug: DrugId = isDrugId(queried) ? queried : (root.dataset.drug as DrugId);
  let minutes = parseMinutes(params.get('t')) ?? DEFAULT_MINUTES;
  // A drug outside this language's list (Ritalin LA via ?drug=) is added so the select agrees with the page.
  if (![...drugSelect.options].some((o) => o.value === drug)) drugSelect.add(new Option(t.names[drug], drug));
  drugSelect.value = drug;
  timeInput.value = toHHMM(minutes);

  // The dose time travels only inside this link, not in the address bar.
  const shareUrl = () => `${location.origin}${base}${drug}/?t=${toHHMM(minutes)}`;

  function draw() {
    const r = render({ lang, drug, minutes, nowHours: hoursSinceDose(new Date(), minutes) });
    out.status.innerHTML = r.status;
    out.legend.innerHTML = r.legend;
    out.chart.innerHTML = r.chart;
    out.axis.innerHTML = r.axis;
    out.summary.innerHTML = r.summary;
    out.sources.innerHTML = r.sources;
    document.title = t.title(t.names[drug]);
  }

  function update(fromUser: boolean) {
    draw();
    // Only the drug goes into the URL, and only when it changed.
    const path = `${base}${drug}/`;
    if (fromUser && location.pathname !== path) history.replaceState(null, '', path);
  }

  drugSelect.addEventListener('change', () => {
    if (isDrugId(drugSelect.value)) drug = drugSelect.value;
    update(true);
  });
  timeInput.addEventListener('change', () => {
    const parsed = parseMinutes(timeInput.value);
    if (parsed === null) return;
    minutes = parsed;
    update(true);
  });
  copyButton.addEventListener('click', async () => {
    const url = shareUrl();
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      // Clipboard blocked (older WebView): the share sheet, if any, carries the link instead.
      if (navigator.share) {
        try {
          await navigator.share({ url });
        } catch {}
      }
      return;
    }
    const label = copyButton.textContent;
    copyButton.textContent = copyButton.dataset.copied ?? label;
    setTimeout(() => (copyButton.textContent = label), 1800);
  });

  update(false);
  // The marker follows the clock.
  setInterval(draw, 60_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) draw();
  });
</script>
