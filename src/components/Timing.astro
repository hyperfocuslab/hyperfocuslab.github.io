---
// The reference concentration curve: one page per language, plus one per drug so each share link
// gets its own card. The default state (dose at 08:00) is rendered at build; the browser re-renders
// on every change. The drug is kept in the path by its ingredient-and-form slug
// (/ko/peakly/timing/methylphenidate-oros/); catalog ids never reach the HTML or the URL. The dose
// time goes only into the link the copy button makes (?t=08:00), never into the address bar, so
// the site's analytics (Base.astro) sees the path and not the dose time. The curve itself is
// computed in the page and the inputs are not sent to any server.
// Nothing about the app sits near the drug or the chart: one plain link at the foot of the page.
import Base from '../layouts/Base.astro';
import { href } from '../i18n';
import type { ToolDrugId } from '../lib/pk';
import { DEFAULT_DRUG, DEFAULT_MINUTES, DRUG_SLUGS, copy, describe, langsFor, render, selectGroups, toHHMM, type TimingLang } from '../lib/timing';

interface Props {
  lang: TimingLang;
  /** The drug page; the index page leaves it out and starts with the default drug. */
  drug?: ToolDrugId;
}
const { lang, drug } = Astro.props;
const t = copy[lang];
const current = drug ?? DEFAULT_DRUG;
const first = render({ lang, drug: current, minutes: DEFAULT_MINUTES, nowHours: null });
const title = t.title(t.names[current]);
const description = describe(lang, current);
const ogImage = `/assets/og/timing-${lang}-${DRUG_SLUGS[current]}.png`;
const groups = selectGroups(lang, current);
---

<Base
  lang={lang}
  page="timing"
  sub={drug && DRUG_SLUGS[drug]}
  subLangs={drug && langsFor(drug)}
  title={title}
  description={description}
  ogImage={ogImage}
>
  <section class="section timing" id="timing" data-lang={lang} data-drug={DRUG_SLUGS[current]} data-base={href('timing', lang)}>
    <div class="wrap">
      <header class="timing-head">
        <p class="label">{t.label}</p>
        <h1 class="h2">{t.h1}</h1>
      </header>

      <form class="pk-controls" id="pk-form">
        <label>
          <span class="label">{t.drug}</span>
          <select name="drug" id="pk-drug">
            {groups[0].ids.map((id) => <option value={DRUG_SLUGS[id]} selected={id === current}>{t.names[id]}</option>)}
            {groups[1].ids.length > 0 && (
              <optgroup label={groups[1].label}>
                {groups[1].ids.map((id) => <option value={DRUG_SLUGS[id]} selected={id === current}>{t.names[id]}</option>)}
              </optgroup>
            )}
          </select>
        </label>
        <label>
          <span class="label">{t.time}</span>
          <input type="time" name="t" id="pk-time" value={toHHMM(DEFAULT_MINUTES)} step="300" required />
        </label>
      </form>

      <div class="pk-panel">
        <!-- The copy button sits where the app's card keeps its one action ("구간 조정"). -->
        <div class="pk-panel-head">
          <div class="pk-status" id="pk-status" set:html={first.status} />
          <button type="button" class="pk-pill" id="pk-copy" data-copied={t.copied}>{t.copy}</button>
        </div>
        <div class="pk-legend" id="pk-legend" set:html={first.legend} />
        <div class="pk-chart" id="pk-chart" set:html={first.chart} />
        <div class="pk-axis" id="pk-axis" set:html={first.axis} />
      </div>

      <section class="pk-sources" aria-labelledby="pk-sources-title">
        <h2 class="label" id="pk-sources-title">{t.sourcesTitle}</h2>
        <div id="pk-sources" set:html={first.sources} />
      </section>

      <p class="pk-notice">{t.notice}</p>
      <p class="pk-about"><a href={href('peakly', lang)}>{t.about}</a></p>
    </div>
  </section>
</Base>

<script>
  import type { ToolDrugId } from '../lib/pk';
  import { DEFAULT_DRUG, DEFAULT_MINUTES, DRUG_SLUGS, PROFILES, copy, drugIn, hoursSinceDose, parseMinutes, render, toHHMM, type TimingLang } from '../lib/timing';

  const root = document.getElementById('timing')!;
  const lang = root.dataset.lang as TimingLang;
  const base = root.dataset.base!;
  const t = copy[lang];
  const drugSelect = document.getElementById('pk-drug') as HTMLSelectElement;
  const timeInput = document.getElementById('pk-time') as HTMLInputElement;
  const copyButton = document.getElementById('pk-copy') as HTMLButtonElement;
  const out = {
    status: document.getElementById('pk-status')!,
    legend: document.getElementById('pk-legend')!,
    chart: document.getElementById('pk-chart')!,
    axis: document.getElementById('pk-axis')!,
    sources: document.getElementById('pk-sources')!,
  };

  // State comes from the page's drug, then the query (?drug=methylphenidate-oros&t=08:00) on top.
  // Slugs only: an unknown slug, or one this language has no page for (an en-only drug on a ko
  // page), leaves the page's own drug, which on the index page is the default.
  const params = new URLSearchParams(location.search);
  let drug: ToolDrugId = drugIn(lang, params.get('drug')) ?? drugIn(lang, root.dataset.drug) ?? DEFAULT_DRUG;
  let minutes = parseMinutes(params.get('t')) ?? DEFAULT_MINUTES;
  // A drug outside this language's list (Ritalin LA via ?drug=) is added so the select agrees with the page.
  const slug = () => DRUG_SLUGS[drug];
  if (![...drugSelect.options].some((o) => o.value === slug())) drugSelect.add(new Option(t.names[drug], slug()));
  drugSelect.value = slug();
  timeInput.value = toHHMM(minutes);

  // The dose time travels only inside this link, not in the address bar.
  const shareUrl = () => `${location.origin}${base}${slug()}/?t=${toHHMM(minutes)}`;

  function draw() {
    const r = render({ lang, drug, minutes, nowHours: hoursSinceDose(new Date(), minutes, PROFILES[drug].chartEndHours) });
    out.status.innerHTML = r.status;
    out.legend.innerHTML = r.legend;
    fitLegend();
    out.chart.innerHTML = r.chart;
    out.axis.innerHTML = r.axis;
    out.sources.innerHTML = r.sources;
    document.title = t.title(t.names[drug]);
  }

  // As the app's PKPhaseLegend (ViewThatFits): one line when the three fit, one row per window otherwise.
  function fitLegend() {
    const items = out.legend.children;
    out.legend.classList.remove('stacked');
    const first = items[0] as HTMLElement | undefined;
    const last = items[items.length - 1] as HTMLElement | undefined;
    if (first && last && last.offsetTop > first.offsetTop) out.legend.classList.add('stacked');
  }
  window.addEventListener('resize', fitLegend);
  document.fonts?.ready.then(fitLegend);

  function update(fromUser: boolean) {
    draw();
    // Only the drug goes into the URL, and only when it changed.
    const path = `${base}${slug()}/`;
    if (fromUser && location.pathname !== path) history.replaceState(null, '', path);
  }

  drugSelect.addEventListener('change', () => {
    drug = drugIn(lang, drugSelect.value) ?? drug;
    update(true);
  });
  timeInput.addEventListener('change', () => {
    const parsed = parseMinutes(timeInput.value);
    if (parsed === null) return;
    minutes = parsed;
    update(true);
  });
  copyButton.addEventListener('click', async () => {
    const url = shareUrl();
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      // Clipboard blocked (older WebView): the share sheet, if any, carries the link instead.
      if (navigator.share) {
        try {
          await navigator.share({ url });
        } catch {}
      }
      return;
    }
    const label = copyButton.textContent;
    copyButton.textContent = copyButton.dataset.copied ?? label;
    setTimeout(() => (copyButton.textContent = label), 1800);
  });

  update(false);
  // The marker follows the clock.
  setInterval(draw, 60_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) draw();
  });
</script>
