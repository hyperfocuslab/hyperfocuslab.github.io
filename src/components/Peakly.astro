---
import Base from '../layouts/Base.astro';
import Lines from './Lines.astro';
import StoreBadges from './StoreBadges.astro';
import peakly from '../data/peakly.json';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = peakly[lang];
const pairs = [p.medication, p.condition];
---

<Base lang={lang} page="peakly" title={p.meta.title} description={p.meta.description}>
  <section class="wrap p-hero">
    <div class="p-hero-copy">
      <div class="product-name">
        <img class="app-icon" src="/assets/peakly-logo.png" alt="" width="60" height="60" />
        <div>
          <p class="h3">{ui[lang].appName}</p>
          <p class="muted">{p.tagline}</p>
        </div>
      </div>
      <h1 class="display"><Lines lines={p.hero.title} /></h1>
      <p class="lead">{p.hero.lead.join(' ')}</p>
      <StoreBadges lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-3">
      {
        p.values.map((v) => (
          <div class="cell">
            <p class="label">{v.label}</p>
            <h2 class="h3">{v.title}</h2>
            <p>{v.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    pairs.map((s, i) => (
      <section class="section" id={i === 0 ? 'medication' : 'condition'}>
        <div class="wrap split">
          <div class="section-head">
            <p class="label">{s.badge}</p>
            <h2 class="h2"><Lines lines={s.title} /></h2>
            <p class="lead">{s.lead}</p>
          </div>
          <div class="rows">
            {s.rows.map((row) => (
              <div>
                <h3 class="h3">{row.title}</h3>
                <p>{row.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section" id="features">
    <div class="wrap">
      <div class="section-head">
        <p class="label">{p.features.badge}</p>
        <h2 class="h2"><Lines lines={p.features.title} /></h2>
        <p class="lead">{p.features.lead}</p>
      </div>
      <div class="grid-3">
        {
          p.features.items.map((f) => (
            <div class="cell">
              <h3 class="h3">{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="workflow">
    <div class="wrap">
      <div class="section-head">
        <p class="label">{p.workflow.badge}</p>
        <h2 class="h2"><Lines lines={p.workflow.title} /></h2>
        <p class="lead">{p.workflow.lead}</p>
      </div>
      <ol class="grid-3 steps">
        {
          p.workflow.items.map((step) => (
            <li class="cell">
              <h3 class="h3">{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta">
        <h2 class="h2"><Lines lines={p.cta.title} /></h2>
        <p class="lead">{p.cta.body.join(' ')}</p>
        <StoreBadges lang={lang} />
      </div>
    </div>
  </section>
</Base>
