---
import Timing from '../../../../../components/Timing.astro';
import type { ToolDrugId } from '../../../../../lib/pk';
import { DRUG_SLUGS, TIMING_LANGS, drugsFor, type TimingLang } from '../../../../../lib/timing';

// One page per drug so a shared link previews that drug's curve. The path carries the
// ingredient-and-form slug (/en/peakly/timing/lisdexamfetamine/); each language has its own list.
export function getStaticPaths() {
  return TIMING_LANGS.flatMap((lang) => drugsFor(lang).map((drug) => ({ params: { lang, drug: DRUG_SLUGS[drug] }, props: { drug } })));
}
const lang = Astro.params.lang as TimingLang;
const { drug } = Astro.props as { drug: ToolDrugId };
---

<Timing lang={lang} drug={drug} />
