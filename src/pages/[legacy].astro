---
import { SITE, legacySlugs } from '../i18n';

// /privacy.html, /terms-en.html, /index-ja.html ... → their new home under /peakly/.
export function getStaticPaths() {
  return legacySlugs().map(({ slug, to }) => ({ params: { legacy: slug }, props: { to } }));
}
const { to } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Peakly</title>
    <link rel="canonical" href={SITE + to} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex" />
  </head>
  <body><a href={to}>{SITE + to}</a></body>
</html>
